@page "/"
@attribute [AllowAnonymous]
@layout client.Components.Layout.LandingLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<nav class="landing-nav">
    <a class="landing-logo" href="/">⛳ GolfCoach</a>
    <div class="landing-nav-actions">
        <a href="/login" class="landing-btn-ghost">Sign In</a>
        <a href="/signup" class="landing-btn-cta">Get Started Free</a>
    </div>
</nav>

<section class="hero">
    <div class="hero-inner">
        <div class="hero-badge">⛳ Community Golf Coaching</div>
        <h1 class="hero-title">
            Get Real Feedback<br />
            <span class="hero-accent">On Your Game</span>
        </h1>
        <p class="hero-sub">
            Upload your swing, share your technique, and get honest insights
            from a community of golfers at every skill level.
        </p>
        <div class="hero-actions">
            <a href="/signup" class="hero-btn-primary">Start for Free</a>
            <a href="/login" class="hero-btn-secondary">Sign In</a>
        </div>
        <div class="hero-stats">
            <div class="hero-stat">
                <span class="hero-stat-number">500+</span>
                <span class="hero-stat-label">Swings Shared</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-number">200+</span>
                <span class="hero-stat-label">Golfers</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-number">1,000+</span>
                <span class="hero-stat-label">Tips Given</span>
            </div>
        </div>
    </div>
</section>

<section class="lp-features">
    <div class="lp-section-inner">
        <p class="lp-section-tag">FEATURES</p>
        <h2 class="lp-section-title">Everything you need to improve</h2>
        <div class="lp-features-grid">
            <div class="lp-feature-card">
                <div class="lp-feature-icon">📹</div>
                <h3>Share Your Swing</h3>
                <p>Upload photos or videos of your technique for the community to review and critique.</p>
            </div>
            <div class="lp-feature-card">
                <div class="lp-feature-icon">💬</div>
                <h3>Get Coaching Tips</h3>
                <p>Receive detailed comments and actionable advice from experienced golfers who've been there.</p>
            </div>
            <div class="lp-feature-card">
                <div class="lp-feature-icon">🏆</div>
                <h3>Best Advice Surfaces</h3>
                <p>The top tips get upvoted and pinned with medals so you never miss the most valuable feedback.</p>
            </div>
        </div>
    </div>
</section>

<section class="lp-how">
    <div class="lp-section-inner">
        <p class="lp-section-tag">HOW IT WORKS</p>
        <h2 class="lp-section-title">Three steps to a better swing</h2>
        <div class="lp-steps">
            <div class="lp-step">
                <div class="lp-step-number">01</div>
                <h3>Create Your Profile</h3>
                <p>Sign up free and set your skill level — beginner, intermediate, or experienced.</p>
            </div>
            <div class="lp-step">
                <div class="lp-step-number">02</div>
                <h3>Upload Your Swing</h3>
                <p>Share a photo or video of any shot — full swing, chip, putt, doesn't matter.</p>
            </div>
            <div class="lp-step">
                <div class="lp-step-number">03</div>
                <h3>Get Better</h3>
                <p>Read community tips, upvote the best advice, and apply it on the course.</p>
            </div>
        </div>
    </div>
</section>

<section class="lp-cta">
    <div class="lp-cta-inner">
        <h2>Ready to lower your handicap?</h2>
        <p>Join golfers sharing their swings and improving together — completely free.</p>
        <a href="/signup" class="hero-btn-primary lp-cta-btn">Create Free Account</a>
    </div>
</section>

<footer class="landing-footer">
    <span>© 2026 GolfCoach — Built for golfers, by golfers.</span>
</footer>

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo("/feed");
    }
}
